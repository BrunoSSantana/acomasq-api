{
  "name": "acomasq-api",
  "version": "0.0.1",
  "description": "acomasq-api",
  "author": "BrunoSSantana",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "rimraf dist && tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.build.json && nest build",
    "build": "nest build",
    "style:check": "npx @biomejs/biome check --write ./src",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate --schema=./src/infra/repositories/prisma/schema.prisma",
    "prisma:migration": "prisma migrate dev --schema=./src/infra/repositories/prisma/schema.prisma",
    "prisma:migration:push": "prisma migrate deploy --schema=./src/infra/repositories/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/infra/repositories/prisma/schema.prisma",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:cov": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest --config vitest.e2e.config.mts",
    "test:create-prisma-environment": "npm link ./src/infra/repositories/prisma/vitest-environment-prisma",
    "test:install-prisma-environment": "npm link vitest-environment-prisma",
    "pretest:e2e": "npm run test:create-prisma-environment && npm run test:install-prisma-environment"
  },
  "dependencies": {
    "@anatine/zod-openapi": "2.2.6",
    "@nestjs/axios": "3.1.2",
    "@nestjs/common": "10.4.8",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.8",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.8",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/terminus": "10.2.3",
    "@prisma/client": "5.22.0",
    "@scalar/nestjs-api-reference": "0.3.168",
    "axios": "1.7.7",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "module-alias": "2.2.3",
    "passport": "0.7.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.1",
    "zod": "3.23.8",
    "zod-validation-error": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@faker-js/faker": "9.2.0",
    "@nestjs/cli": "10.4.7",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.8",
    "@swc/cli": "0.5.0",
    "@swc/core": "1.9.2",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.0",
    "@types/node": "22.9.0",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-istanbul": "2.1.5",
    "@vitest/coverage-v8": "2.1.5",
    "@vitest/ui": "2.1.5",
    "prisma": "5.22.0",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.5"
  },
  "_moduleAliases": {
    "@": "dist"
  }
}
